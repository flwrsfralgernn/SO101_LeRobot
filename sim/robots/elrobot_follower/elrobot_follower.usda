#usda 1.0
(
    customLayerData = {
        string creator = "URDF USD Converter v0.1.2"
    }
    defaultPrim = "Elrobot"
    doc = """Generated from Composed Stage of root layer /tmp/tmpzh818sm_/Elrobot.usdc


Generated from Composed Stage of root layer /tmp/urdf_import_elrobot_follower_fm5y55r2/usdex_elrobot_follower/Elrobot.usdc


Generated from Composed Stage of root layer /tmp/urdf_import_elrobot_follower_fm5y55r2/temp_elrobot_follower/elrobot_follower.usd


Generated from Composed Stage of root layer /home/rog/Downloads/so101_lerobot/sim/robots/elrobot_follower/payloads/base.usd
"""
    kilogramsPerUnit = 1
    metersPerUnit = 1
    upAxis = "Z"
)

def Xform "Elrobot" (
    prepend references = @./payloads/base.usda@
    variants = {
        string Physics = "physx"
    }
    append variantSets = "Physics"
)
{
    variantSet "Physics" = {
        "mujoco" (
            prepend payload = @./payloads/Physics/mujoco.usda@
        ) {

        }
        "none" {

        }
        "physics" (
            prepend payload = @./payloads/Physics/physics.usda@
        ) {

        }
        "physx" (
            prepend payload = @./payloads/Physics/physx.usda@
        ) {

        }
    }
}

over "Flattened_Prototype_19"
{
    def Shader "PreviewSurface"
    {
        uniform token info:id = "UsdPreviewSurface"
        color3f inputs:diffuseColor.connect = </Flattened_Prototype_19.inputs:diffuseColor>
        float inputs:metallic.connect = </Flattened_Prototype_19.inputs:metallic>
        float inputs:opacity.connect = </Flattened_Prototype_19.inputs:opacity>
        float inputs:roughness.connect = </Flattened_Prototype_19.inputs:roughness>
        token outputs:displacement
        token outputs:surface
    }
}

